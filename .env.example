# CareLoop — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel project settings for prod.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; used by cron routes, webhooks, and AI extraction

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # public base URL; also builds the Twilio webhook URL for signature validation and, when https, the StatusCallback for delivery receipts
CRON_SECRET=                          # random string; Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/cron/*

# --- AI ---
GEMINI_API_KEY=                       # Gemini: PDF extraction, translation, triage, patient Q&A
GEMINI_MODEL=                         # optional — primary model (default gemini-2.5-flash)
GEMINI_FALLBACK_MODELS=               # optional — tried in order when the primary is overloaded or out of quota (default gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.1-pro-preview)
GROQ_API_KEY=                         # optional — asked when every Gemini model has refused (text calls only; a free Gemini tier runs dry)
GROQ_MODELS=                          # optional — tried in order (default openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b)
OPENAI_API_KEY=                       # optional — Whisper fallback for voice notes; Gemini transcribes by default

# --- WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886   # Twilio sandbox number, or your approved sender
WHATSAPP_USE_TEXT_FALLBACK=true       # send plain text instead of approved templates (required while on the sandbox)
